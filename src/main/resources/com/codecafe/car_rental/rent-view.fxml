<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="555.0" prefWidth="890.0" styleClass="content-bg" stylesheets="@dashboardDesign.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecafe.car_rental.RentCarController">
   <children>
      <HBox spacing="18.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="18.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="18.0">
         <children>
            <!-- Left Side: Table of Available Cars -->
            <VBox prefWidth="380.0" spacing="10.0" styleClass="form-panel" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
               </padding>
               <children>
                  <Label styleClass="panel-heading" text="Available Cars For Rent" />
                  <TableView fx:id="availableCarsTableView" onMouseClicked="#selectCarFromTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colCarId" prefWidth="75.0" text="Car ID" />
                      <TableColumn fx:id="colBrand" prefWidth="105.0" text="Brand" />
                      <TableColumn fx:id="colModel" prefWidth="105.0" text="Model" />
                      <TableColumn fx:id="colPrice" prefWidth="85.0" text="Rate/Day" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

            <!-- Right Side: Booking & Payment Form -->
            <VBox prefWidth="460.0" spacing="10.0" styleClass="form-panel">
               <padding>
                  <Insets bottom="14.0" left="18.0" right="18.0" top="12.0" />
               </padding>
               <children>
                  <Label styleClass="panel-heading" text="Customer Booking &amp; Payment" />

                  <!-- Vehicle Selection -->
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Select Car ID" />
                              <ComboBox fx:id="carIdComboBox" maxWidth="1.7976931348623157E308" onAction="#onCarIdSelected" prefHeight="32.0" promptText="Choose ID" styleClass="combo-box" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Brand" />
                              <TextField fx:id="brandField" editable="false" promptText="Auto-filled" styleClass="text-input-field" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Model" />
                              <TextField fx:id="modelField" editable="false" promptText="Auto-filled" styleClass="text-input-field" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Customer Details -->
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Customer First Name" />
                              <TextField fx:id="firstNameField" promptText="First Name" styleClass="text-input-field" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Last Name" />
                              <TextField fx:id="lastNameField" promptText="Last Name" styleClass="text-input-field" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0" prefWidth="120.0">
                           <children>
                              <Label styleClass="field-label" text="Gender" />
                              <ComboBox fx:id="genderComboBox" maxWidth="1.7976931348623157E308" prefHeight="32.0" promptText="Gender" styleClass="combo-box" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Dates & Calculations -->
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Rental Date" />
                              <DatePicker fx:id="dateRentedPicker" maxWidth="1.7976931348623157E308" onAction="#calculateTotalCost" prefHeight="32.0" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Return Date" />
                              <DatePicker fx:id="dateReturnPicker" maxWidth="1.7976931348623157E308" onAction="#calculateTotalCost" prefHeight="32.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Price & Payment Summary Card -->
                  <HBox alignment="CENTER_LEFT" prefHeight="55.0" spacing="15.0" style="-fx-background-color: #0f172a; -fx-padding: 8 14; -fx-background-radius: 8;">
                     <children>
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Rental Days:" textFill="#94a3b8" />
                              <Label fx:id="rentalDaysLabel" text="0 Days" textFill="#f59e0b">
                                 <font>
                                    <javafx.scene.text.Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Total Cost:" textFill="#94a3b8" />
                              <Label fx:id="totalCostLabel" text="\$0.00" textFill="#10b981">
                                 <font>
                                    <javafx.scene.text.Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Payment Amount & Balance -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Amount Paid ($)" />
                              <TextField fx:id="amountPaidField" onKeyReleased="#calculateBalance" promptText="Enter amount" styleClass="text-input-field" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" prefWidth="140.0" spacing="2.0">
                           <children>
                              <Label styleClass="field-label" text="Change / Balance" />
                              <Label fx:id="balanceLabel" text="\$0.00" textFill="#38bdf8">
                                 <font>
                                    <javafx.scene.text.Font name="System Bold" size="15.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Action Buttons -->
                  <HBox spacing="10.0">
                     <padding>
                        <Insets top="6.0" />
                     </padding>
                     <children>
                        <Button fx:id="confirmRentButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#confirmRental" prefHeight="38.0" styleClass="btn-primary" text="✅ Confirm &amp; Rent Vehicle" HBox.hgrow="ALWAYS" />
                        <Button fx:id="clearRentFormButton" mnemonicParsing="false" onAction="#clearRentForm" prefHeight="38.0" styleClass="btn-outline" text="🔄 Reset" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
