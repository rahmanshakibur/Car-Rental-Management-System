<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="555.0" prefWidth="890.0" styleClass="content-bg" stylesheets="@dashboardDesign.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecafe.car_rental.CustomerController">
   <children>
      <VBox spacing="14.0" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="18.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="18.0">
         <children>
            <!-- Header & Search Controls -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label styleClass="panel-heading" text="👥 Customer Rental History" />
                  <TextField fx:id="searchField" onKeyReleased="#searchCustomer" prefHeight="35.0" prefWidth="380.0" promptText="🔍 Search by customer name, car model, ID..." styleClass="text-input-field" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#refreshTable" prefHeight="35.0" styleClass="btn-outline" text="🔄 Refresh List" />
               </children>
            </HBox>

            <!-- Customer Bookings Table -->
            <TableView fx:id="customerTableView" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colCustomerId" prefWidth="65.0" text="Cust ID" />
                <TableColumn fx:id="colFullName" prefWidth="160.0" text="Customer Name" />
                <TableColumn fx:id="colCarDetails" prefWidth="210.0" text="Rented Vehicle" />
                <TableColumn fx:id="colTotal" prefWidth="110.0" text="Total Bill ($)" />
                <TableColumn fx:id="colDateRented" prefWidth="130.0" text="Rental Date" />
                <TableColumn fx:id="colDateReturn" prefWidth="130.0" text="Return Date" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
