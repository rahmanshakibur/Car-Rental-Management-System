<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1100.0" stylesheets="@dashboardDesign.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecafe.car_rental.MainDashboardController">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="1100.0">
         <!-- Top Header -->
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="1100.0" styleClass="top-header-bar" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="window-title" text="  Code Cafe — Car Rental Management System" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="minimizeBtn" mnemonicParsing="false" onAction="#minimizeWindow" prefHeight="40.0" prefWidth="45.0" styleClass="window-control-btn" text="—" />
                  <Button fx:id="closeBtn" mnemonicParsing="false" onAction="#closeWindow" prefHeight="40.0" prefWidth="48.0" styleClass="window-control-btn, close-btn" text="✕" />
               </children>
               <padding>
                  <Insets left="15.0" />
               </padding>
            </HBox>
         </top>

         <!-- Left Sidebar -->
         <left>
            <VBox prefHeight="560.0" prefWidth="215.0" spacing="12.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="16.0" left="12.0" right="12.0" top="15.0" />
               </padding>
               <children>
                  <!-- Code Cafe Logo -->
                  <VBox alignment="CENTER" prefHeight="75.0" prefWidth="190.0">
                     <children>
                        <ImageView fitHeight="65.0" fitWidth="175.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../images/codecafe_logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </VBox>

                  <!-- Admin Info Badge -->
                  <VBox alignment="CENTER" spacing="2.0">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" text="Welcome back," />
                        <Label fx:id="usernameLabel" styleClass="user-badge" text="Sakibur Rahman" />
                        <Label styleClass="user-role-badge" text="ADMINISTRATOR" />
                     </children>
                  </VBox>

                  <Line endX="90.0" startX="-90.0" stroke="#334155" />

                  <!-- Menu Navigation -->
                  <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button fx:id="homeBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showHomeView" styleClass="nav-menu-btn-active" text="📊  Dashboard Home" />
                        <Button fx:id="carsBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCarsView" styleClass="nav-menu-btn" text="🚗  Manage Vehicles" />
                        <Button fx:id="rentBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showRentView" styleClass="nav-menu-btn" text="📝  Rent a Vehicle" />
                        <Button fx:id="customersBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCustomersView" styleClass="nav-menu-btn" text="👥  Customer History" />
                     </children>
                  </VBox>

                  <!-- Sign Out Button -->
                  <Button fx:id="signOutBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSignOut" styleClass="signout-btn" text="🚪  Sign Out" />
               </children>
            </VBox>
         </left>

         <!-- Center Dynamic View Content Area -->
         <center>
            <StackPane fx:id="contentArea" prefHeight="560.0" prefWidth="885.0" styleClass="content-bg" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
   </children>
</StackPane>
