<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="555.0" prefWidth="890.0" styleClass="content-bg" stylesheets="@dashboardDesign.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecafe.car_rental.HomeController">
   <children>
      <VBox spacing="18.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <!-- Top Metric Cards -->
            <HBox spacing="20.0">
               <children>
                  <VBox alignment="CENTER_LEFT" prefHeight="95.0" prefWidth="270.0" spacing="6.0" styleClass="card-amber" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                     </padding>
                     <children>
                        <Label styleClass="card-title" text="AVAILABLE VEHICLES" />
                        <Label fx:id="availableCarsLabel" styleClass="card-value" text="0" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" prefHeight="95.0" prefWidth="270.0" spacing="6.0" styleClass="card-green" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                     </padding>
                     <children>
                        <Label styleClass="card-title" text="TOTAL REVENUE" />
                        <Label fx:id="totalIncomeLabel" styleClass="card-value" text="\$0.0" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" prefHeight="95.0" prefWidth="270.0" spacing="6.0" styleClass="card-blue" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                     </padding>
                     <children>
                        <Label styleClass="card-title" text="TOTAL CUSTOMERS" />
                        <Label fx:id="totalCustomersLabel" styleClass="card-value" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Bottom Analytics Charts -->
            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefHeight="380.0" prefWidth="420.0" styleClass="form-panel" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="12.0" />
                     </padding>
                     <children>
                        <Label styleClass="panel-heading" text="Daily Income Overview ($)" />
                        <BarChart fx:id="incomeBarChart" legendVisible="false" prefHeight="330.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
                          <xAxis>
                            <CategoryAxis label="Rental Date" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="Income ($)" side="LEFT" />
                          </yAxis>
                        </BarChart>
                     </children>
                  </VBox>
                  <VBox prefHeight="380.0" prefWidth="420.0" styleClass="form-panel" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="12.0" />
                     </padding>
                     <children>
                        <Label styleClass="panel-heading" text="Customer Booking Activity" />
                        <LineChart fx:id="customerLineChart" legendVisible="false" prefHeight="330.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
                          <xAxis>
                            <CategoryAxis label="Rental Date" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="Bookings" side="LEFT" />
                          </yAxis>
                        </LineChart>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
