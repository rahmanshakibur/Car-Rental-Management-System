<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="555.0" prefWidth="890.0" styleClass="content-bg" stylesheets="@dashboardDesign.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecafe.car_rental.CarManagementController">
   <children>
      <HBox spacing="18.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="18.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="18.0">
         <children>
            <!-- Left Side: Search & TableView -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="searchField" onKeyReleased="#searchCar" prefHeight="35.0" promptText="🔍 Search vehicle by brand, model, ID..." styleClass="text-input-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <TableView fx:id="carTableView" onMouseClicked="#selectCarFromTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colCarId" prefWidth="75.0" text="Car ID" />
                      <TableColumn fx:id="colBrand" prefWidth="130.0" text="Brand" />
                      <TableColumn fx:id="colModel" prefWidth="130.0" text="Model" />
                      <TableColumn fx:id="colPrice" prefWidth="100.0" text="Price / Day ($)" />
                      <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

            <!-- Right Side: Vehicle Details & Operations Form -->
            <VBox prefWidth="325.0" spacing="10.0" styleClass="form-panel">
               <padding>
                  <Insets bottom="15.0" left="16.0" right="16.0" top="14.0" />
               </padding>
               <children>
                  <Label styleClass="panel-heading" text="Vehicle Information" />
                  
                  <!-- Image Preview Box -->
                  <HBox alignment="CENTER" spacing="12.0">
                     <children>
                        <StackPane prefHeight="95.0" prefWidth="125.0" styleClass="image-preview-frame">
                           <children>
                              <ImageView fx:id="carImageView" fitHeight="90.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </StackPane>
                        <Button fx:id="browseImageButton" mnemonicParsing="false" onAction="#chooseCarImage" styleClass="btn-outline" text="📷 Choose Image" />
                     </children>
                  </HBox>

                  <!-- Input Fields (Reordered logically: Brand -> Model -> Car ID -> Price -> Status) -->
                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="field-label" text="Car Brand" />
                        <TextField fx:id="brandField" promptText="e.g. Toyota, BMW" styleClass="text-input-field" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="field-label" text="Car Model" />
                        <TextField fx:id="modelField" promptText="e.g. Corolla, Civic" styleClass="text-input-field" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="field-label" text="Car ID (Unique Number)" />
                        <TextField fx:id="carIdField" promptText="e.g. 101, 202" styleClass="text-input-field" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="field-label" text="Daily Rental Price ($)" />
                        <TextField fx:id="priceField" promptText="e.g. 50.0" styleClass="text-input-field" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="field-label" text="Availability Status" />
                        <ComboBox fx:id="statusComboBox" maxWidth="1.7976931348623157E308" prefHeight="32.0" promptText="Select Status" styleClass="combo-box" />
                     </children>
                  </VBox>

                  <!-- Action Buttons -->
                  <VBox spacing="8.0">
                     <padding>
                        <Insets top="8.0" />
                     </padding>
                     <children>
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="addCarButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addCar" styleClass="btn-primary" text="➕ Add Vehicle" HBox.hgrow="ALWAYS" />
                              <Button fx:id="updateCarButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#updateCar" styleClass="btn-secondary" text="✏️ Update" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="deleteCarButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#deleteCar" styleClass="btn-danger" text="🗑️ Delete" HBox.hgrow="ALWAYS" />
                              <Button fx:id="clearFieldsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearFields" styleClass="btn-outline" text="🔄 Reset" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
